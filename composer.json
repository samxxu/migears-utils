{
    "name": "migears/utils",
    "description": "Minimalist utility collection — immutable URLs and pagination DTOs",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com"
        }
    ],
    "keywords": [
        "utils",
        "helpers",
        "url",
        "pagination",
        "immutable",
        "migears"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Utils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Utils\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
