{
    "name": "migears/utils",
    "description": "Minimalist utility collection — strings, arrays, dates, URLs, pagination",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": ["utils", "helpers", "string", "array", "date", "url", "pagination", "migears"],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "suggest": {
        "ext-intl": "Required for Str::ascii() transliteration fallback"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Utils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Utils\\Tests\\": "tests/"
        }
    }
}
